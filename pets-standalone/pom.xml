<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>pets-build</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>pets-standalone</artifactId>
    <!-- Published at the plugin's own version. -->
    <version>${plugin.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Pets</name>
    <description>
        Rain's Pets, as a plugin of its own: the pets module and the standard wrapper, shaded together.
    </description>

    <properties>
        <plugin.name>RainsPets</plugin.name>
        <!-- 0.1.0: pets that fight beside you — vanilla animals in four roles, levels, modes, knock-outs instead of death,
             unlocked by playing, bought, granted, or kept for supporters. -->
        <!-- 0.2.0: pets explore while their owner stands about or they stay — how far and how often is a new trait,
             curiosity (and a Curious personality); a pet's particles picked like on the cosmetics page (Core's particle
             chooser); an unlock can ask for several things at once, and every mythic asks for every boss. -->
        <plugin.version>0.10.1</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>pets-module</artifactId>
            <version>${pets-module.version}</version>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- StandaloneJarTest reads the built jar, so it runs after the jar exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
